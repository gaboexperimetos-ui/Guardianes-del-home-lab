#!/bin/bash
# ============================================================================
# guardian-perfil — mantiene el perfil de energia que TU elegiste
#
#   max-performance.timer (servicio de root) escribe platform_profile=performance
#   en cada arranque, lo que pone EPP=performance y deja 10 cores a 4.2 GHz con
#   la CPU ociosa (95 C). Este guardian lo detecta y revierte el perfil en
#   menos de 20 s, sin necesitar root.
#
#   Fuente de verdad: ~/.config/perfil/actual (lo escribe `perfil`)
#   Parar:  systemctl --user stop guardian-perfil
# ============================================================================
set -u

ESTADO="$HOME/.config/perfil/actual"

esperado_epp() {
    case "$1" in
        Performance) echo "performance" ;;
        Balanced)    echo "balance_power" ;;
        Quiet)       echo "power" ;;
        *)           echo "" ;;
    esac
}

esperado_gob() {
    case "$1" in
        Performance) echo "performance" ;;
        *)           echo "powersave" ;;
    esac
}

while true; do
    sleep 10
    [ -r "$ESTADO" ] || continue
    guardado=$(cat "$ESTADO" 2>/dev/null)
    case "$guardado" in
        rendimiento) quiero=Performance ;;
        medio)       quiero=Balanced ;;
        bateria)     quiero=Quiet ;;
        *)           continue ;;
    esac

    actual=$(asusctl profile get 2>/dev/null | sed -n 's/^Active profile: *//p')
    epp=$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null)
    gob=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)
    objetivo_epp=$(esperado_epp "$quiero")
    objetivo_gob=$(esperado_gob "$quiero")

    if [ "$actual" != "$quiero" ] \
       || { [ -n "$objetivo_epp" ] && [ "$epp" != "$objetivo_epp" ]; } \
       || { [ -n "$objetivo_gob" ] && [ "$gob" != "$objetivo_gob" ]; }; then
        asusctl profile set "$quiero" >/dev/null 2>&1
        logger -t guardian-perfil "perfil restaurado: $quiero (estaba $actual / EPP $epp / gob $gob)"
    fi
done
